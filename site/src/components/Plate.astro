---
// One real screen of editor, rendered headless from the app at 1040 by 650 points, 2x, as AVIF with a WebP
// fallback. `load`: "high" for the first viewport, "low" for screens the page swaps in
// without a delay, "lazy" for the rest.
interface Props {
  name: string;
  alt: string;
  sizes: string;
  load?: "high" | "low" | "lazy";
  hidden?: boolean;
  class?: string;
}
const { name, alt, sizes, load = "lazy", hidden = false, class: cls } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const set = (ext: string) => `${base}plates/${name}-1x.${ext} 1040w, ${base}plates/${name}-2x.${ext} 2080w`;
---

<picture class={cls} hidden={hidden} data-plate={name}>
  <source type="image/avif" srcset={set("avif")} sizes={sizes} />
  <source type="image/webp" srcset={set("webp")} sizes={sizes} />
  <img
    src={`${base}plates/${name}-1x.webp`}
    width="1040"
    height="650"
    alt={alt}
    loading={load === "lazy" ? "lazy" : "eager"}
    decoding="async"
    fetchpriority={load === "high" ? "high" : load === "low" ? "low" : "auto"}
  />
</picture>
