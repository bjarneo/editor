---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import Plate from "../components/Plate.astro";
import themes from "../data/themes.json";
import "../styles/site.css";

// The version on the page and in every download link is the latest release, which the Pages
// workflow passes in EDITOR_VERSION. Without it (a local build), the crate's version is used.
// Astro builds from site/, so the crate is one folder up.
const cargo = readFileSync(resolve(process.cwd(), "../Cargo.toml"), "utf8");
const version = process.env.EDITOR_VERSION || (cargo.match(/^version\s*=\s*"([^"]+)"/m)?.[1] ?? "0.0.0");
const repo = "https://github.com/bjarneo/editor";
const tag = `v${version}`;
const archive = (target: string) => `editor-${tag}-${target}.tar.gz`;
const asset = (target: string) => `${repo}/releases/download/${tag}/${archive(target)}`;
const targets = [
  { id: "x86_64-linux", system: "Linux", arch: "x86-64" },
  { id: "aarch64-linux", system: "Linux", arch: "ARM64" },
  { id: "aarch64-macos", system: "macOS", arch: "Apple silicon" },
  { id: "x86_64-macos", system: "macOS", arch: "Intel" },
];
const downloads = Object.fromEntries(targets.map((t) => [t.id, { href: asset(t.id), file: archive(t.id), system: t.system, arch: t.arch }]));
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const install = `cargo install --locked --git ${repo}`;
const dark = themes.filter((t) => !t.light).length;
const light = themes.length - dark;

const modes = [
  { id: "normal", label: "NORMAL", key: "Esc", alt: "editor in Normal mode: the file tree, three tabs, and Rust code with the cursor in a struct." },
  { id: "insert", label: "INSERT", key: "i", alt: "editor in Insert mode: the status line shows a green INSERT pill and the cursor is a bar." },
  { id: "visual", label: "VISUAL", key: "v", alt: "editor in Visual line mode: four lines are selected and the status line shows a violet V-LINE pill." },
  { id: "command", label: "COMMAND", key: ":", alt: "editor in Command mode: the command line holds :%s/Reg/Register/g and the status line shows an orange COMMAND pill." },
];

const keys = [
  ["Find a file", ["SPC", "f"], ["Ctrl", "P"]],
  ["Search the project", ["SPC", "/"], ["Ctrl", "⇧", "F"]],
  ["Save", [":w"], ["Ctrl", "S"]],
  ["Undo, redo", ["u", "Ctrl r"], ["Ctrl", "Z"]],
  ["Go to definition", ["gd"], ["F12"]],
  ["Rename a symbol", ["SPC", "l", "n"], ["F2"]],
  ["Code actions", ["SPC", "l", "a"], ["Ctrl", "."]],
  ["Toggle comments", ["gcc"], ["Ctrl", "/"]],
  ["File tree", ["SPC", "e"], ["Ctrl", "B"]],
  ["Settings", ["SPC", ","], ["Ctrl", ","]],
];

// Revision history, newest first. A row shows once its release is the latest or older.
const revisions = [
  {
    rev: "0.3.4",
    date: "2026-11-28",
    changes:
      "A VS Code look with the Neovim modes kept: file icons, tabs that show the mode, breadcrumbs, a scrollbar that marks changes and errors, and git bars in the gutter.",
  },
  {
    rev: "0.3.3",
    date: "2026-11-27",
    changes:
      "On macOS the traffic lights sit in the tab bar, and the tab bar moves the window. Settings has a row for every option, and runs setup again.",
  },
  {
    rev: "0.3.2",
    date: "2026-11-24",
    changes:
      "<code>F1</code> lists every key, with search. The mouse wheel scrolls the file tree. Setup no longer replaces a binary in <code>~/.local/bin</code> with a link to itself.",
  },
  {
    rev: "0.3.1",
    date: "2026-11-24",
    changes:
      "Every key works and is documented: 20 fixes from a full audit, tests for each one, <code>docs/keymaps.md</code> and <code>docs/cli.md</code>.",
  },
  {
    rev: "0.3.0",
    date: "2026-11-24",
    changes:
      "Faster: the finder ranks 200,000 paths in 2 ms a key, the file tree builds off the UI thread, the first edit costs 0.8 ms and <code>:s</code> is 26% faster. The binary is 28% smaller.",
  },
  {
    rev: "0.2.0",
    date: "2026-11-24",
    changes:
      "AI agents drive a running editor over <code>editor ctl</code> and <code>editor mcp</code>. Proposals open as a diff. Outside changes are marked. <code>:'&lt;,'&gt;!cmd</code> filters lines through any command.",
  },
  {
    rev: "0.1.0",
    date: "2026-11-24",
    changes: `First release: Neovim and classic keymaps, tree-sitter objects, LSP, the finder, ${themes.length} themes and Omarchy theming.`,
  },
];
// Compares two versions: above 0 when `a` is newer than `b`.
const newer = (a: string, b: string) => {
  const [x, y] = [a, b].map((v) => v.split(".").map(Number));
  for (let i = 0; i < 3; i++) if ((x[i] ?? 0) !== (y[i] ?? 0)) return (x[i] ?? 0) - (y[i] ?? 0);
  return 0;
};

const shots = [
  { id: "tokyo-night", name: "Tokyo Night" },
  { id: "gruvbox", name: "Gruvbox" },
  { id: "kanagawa", name: "Kanagawa" },
  { id: "rose-pine-dawn", name: "Rosé Pine Dawn" },
  { id: "flexoki-light", name: "Flexoki Light" },
  { id: "nord", name: "Nord" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>editor: read fast, edit quick</title>
    <meta
      name="description"
      content="A native code editor for Linux and macOS. GPU drawn, real Vim keys or classic shortcuts, 16 themes, and an AI agent can drive it from your terminal."
    />
    <meta name="theme-color" content="#0E1016" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={`https://bjarneo.github.io${base}`} />
    <meta property="og:title" content="editor: read fast, edit quick" />
    <meta property="og:description" content="A native code editor for Linux and macOS, on the GPU, with Vim or classic keys." />
    <meta property="og:image" content={`https://bjarneo.github.io${base}plates/normal-2x.webp`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="mode-rule" aria-hidden="true"></div>

    <header class="strip">
      <div class="wrap">
        <a class="mark" href="#top" aria-label="editor, to the top">
          <svg viewBox="0 0 128 128" aria-hidden="true">
            <rect width="128" height="128" rx="28" fill="#151925"></rect>
            <rect x="28" y="32" width="72" height="12" rx="6" fill="#6C9EFF"></rect>
            <rect x="28" y="52" width="50" height="12" rx="6" fill="#A7D46F"></rect>
            <rect x="40" y="72" width="60" height="12" rx="6" fill="#C39BFF"></rect>
            <rect x="28" y="92" width="34" height="12" rx="6" fill="#FFA266"></rect>
          </svg>
          editor
        </a>
        <dl class="meta">
          <div><dt>Rev</dt><dd>{version}</dd></div>
          <div><dt>Runs on</dt><dd>Linux, macOS</dd></div>
          <div><dt>License</dt><dd>MIT</dd></div>
        </dl>
        <nav class="nav" aria-label="Sections">
          <a href="#characteristics">Speed</a>
          <a href="#keys">Keys</a>
          <a href="#agents">Agents</a>
          <a href="#themes">Themes</a>
          <a class="order-link" href="#ordering">Download</a>
          <a class="gh" href={repo}>GitHub</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="wrap lead" aria-labelledby="name">
        <div class="lead-copy">
          <h1 id="name">editor</h1>
          <p class="tagline">Read fast. Edit quick.</p>
          <p class="lede">
            A GPU-drawn native code editor for Linux and macOS.
          </p>
          <div class="actions">
            <a class="download" id="download" href="#ordering">
              <span class="download-label" id="download-label">Download editor {version}</span>
              <span class="download-file" id="download-file">Linux and macOS, x86-64 and ARM64</span>
            </a>
            <a class="all" href="#ordering">Every system</a>
          </div>
        </div>

        <figure class="plate-1" aria-label="Plate 1, editor in each of its modes">
          <div class="frame">
            <figcaption class="frame-title">Plate 1 · src/editor.rs · <b id="mode-name">NORMAL</b></figcaption>
            <div class="screen">
              {
                modes.map((m, i) => (
                  <Plate
                    name={m.id}
                    alt={m.alt}
                    sizes="(max-width: 1100px) 100vw, 58vw"
                    load={i === 0 ? "high" : "low"}
                    hidden={i !== 0}
                  />
                ))
              }
            </div>
            <div class="modes" role="group" aria-label="Show a mode on Plate 1">
              {
                modes.map((m, i) => (
                  <button type="button" data-mode={m.id} aria-pressed={i === 0 ? "true" : "false"} style={`--c: var(--${m.id})`}>
                    <kbd>{m.key}</kbd>
                    {m.label}
                  </button>
                ))
              }
            </div>
          </div>
          <p class="plate-note">Press <kbd>i</kbd>, <kbd>v</kbd>, <kbd>:</kbd> or <kbd>Esc</kbd> on this page. Plate 1 changes in the next frame, as the editor does.</p>
          <p class="sr-only" aria-live="polite" id="mode-said"></p>
        </figure>

        <table class="keychars">
          <caption>Key characteristics</caption>
          <tbody>
            <tr>
              <td><span class="v">175<small>ms</small></span><span class="p">to open a 100 MB file</span></td>
              <td><span class="v">0.3<small>ms</small></span><span class="p">CPU per keystroke frame, median</span></td>
              <td><span class="v">0<small>frames</small></span><span class="p">drawn while the window is idle</span></td>
              <td><span class="v">{themes.length}<small>themes</small></span><span class="p">built in, plus your Omarchy theme</span></td>
              <td><span class="v">2<small>keymaps</small></span><span class="p">Neovim or classic, chosen at setup</span></td>
            </tr>
          </tbody>
        </table>
      </section>

      <section class="wrap sheet" id="screens" aria-labelledby="screens-h">
        <h2 id="screens-h">Screens</h2>
        <p class="intro">Every screen on this page is the real app, rendered from editor itself with <code>editor --snap</code>.</p>
        <div class="grid">
          <figure class="fig f-8">
            <div class="shot"><Plate name="finder" alt="The file finder over the editor: the query key ranks src/app/keys.rs first, with a preview of that file on the right." sizes="(max-width: 1100px) 100vw, 64vw" /></div>
            <figcaption><span class="n">Plate 2</span><strong>Find a file.</strong><span><kbd>SPC</kbd> <kbd>f</kbd> or <kbd>Ctrl</kbd> <kbd>P</kbd>. Fuzzy ranking puts file names first, with a live preview.</span></figcaption>
          </figure>
          <div class="side">
            <p class="muted">The finder, project search, buffers and code actions share one picker. It ranks as you type and previews the file under the cursor.</p>
            <p class="muted">Project search runs ripgrep on a worker thread, so typing never waits on the disk.</p>
          </div>
          <figure class="fig f-6">
            <div class="shot"><Plate name="leader" alt="The leader menu at the bottom of the editor lists find file, grep project, buffers, write, file tree and more, each with its key." sizes="(max-width: 760px) 100vw, 48vw" /></div>
            <figcaption><span class="n">Plate 3</span><strong>The leader menu.</strong><span>Press <kbd>SPC</kbd> alone and every group shows with its keys.</span></figcaption>
          </figure>
          <figure class="fig f-6">
            <div class="shot"><Plate name="multi" alt="The classic keymap with several cursors: each cursor sits on a match of the word Reg." sizes="(max-width: 760px) 100vw, 48vw" /></div>
            <figcaption><span class="n">Plate 4</span><strong>Multiple cursors.</strong><span><kbd>Ctrl</kbd> <kbd>D</kbd> adds a cursor at the next match. Each edit at every cursor is one undo step.</span></figcaption>
          </figure>
          <figure class="fig f-wide">
            <div class="shot"><Plate name="settings" alt="Settings open as a tab: theme cards on the left, a live preview of code and the resulting config.toml on the right." sizes="100vw" /></div>
            <figcaption><span class="n">Plate 5</span><strong>Settings is a buffer.</strong><span>Each change shows at once, in a live preview, and writes plain <code>config.toml</code>.</span></figcaption>
          </figure>
        </div>
      </section>

      <section class="wrap sheet" id="characteristics" aria-labelledby="char-h">
        <h2 id="char-h">Characteristics</h2>
        <p class="intro">Speed decides every feature. A feature that costs latency does not ship.</p>
        <div class="table-wrap">
          <table class="data stack chars">
            <thead>
              <tr><th scope="col">Parameter</th><th scope="col">Conditions</th><th scope="col" class="num">Typ</th><th scope="col" class="num">Target</th><th scope="col">Unit</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">Open a file</th><td>100 MB of Rust, 1.05 million lines</td><td class="num" data-l="Typ" data-u="ms">175</td><td class="num" data-l="Target" data-u="ms">1,000</td><td class="unit">ms</td></tr>
              <tr><th scope="row">Edit, undo and jump</th><td>The same 100 MB file</td><td class="num" data-l="Typ" data-u="µs">24</td><td class="num" data-l="Target" data-u="">–</td><td class="unit">µs</td></tr>
              <tr><th scope="row">Keystroke to frame, CPU, median</th><td>60 keys, headless, 2× scale</td><td class="num" data-l="Typ" data-u="ms">0.3</td><td class="num" data-l="Target" data-u="ms">8</td><td class="unit">ms</td></tr>
              <tr><th scope="row">Keystroke to frame, CPU, 95th percentile</th><td>60 keys, headless, 2× scale</td><td class="num" data-l="Typ" data-u="ms">1.4</td><td class="num" data-l="Target" data-u="ms">8</td><td class="unit">ms</td></tr>
              <tr><th scope="row">Rank the file finder, per key</th><td>200,000 paths</td><td class="num" data-l="Typ" data-u="ms">2.0</td><td class="num" data-l="Target" data-u="ms">8</td><td class="unit">ms</td></tr>
              <tr><th scope="row">First edit after launch</th><td>Any file, the first key that changes it</td><td class="num" data-l="Typ" data-u="ms">0.8</td><td class="num" data-l="Target" data-u="ms">8</td><td class="unit">ms</td></tr>
              <tr><th scope="row">Frames drawn while idle</th><td>No input, no animation</td><td class="num" data-l="Typ" data-u="frames">0</td><td class="num" data-l="Target" data-u="frames">0</td><td class="unit">frames</td></tr>
              <tr><th scope="row">File I/O and LSP on the UI thread</th><td>Any file, any server</td><td class="num" data-l="Typ" data-u="">none</td><td class="num" data-l="Target" data-u="">none</td><td class="unit">–</td></tr>
            </tbody>
          </table>
        </div>
        <p class="note">Release build, Linux x86-64. Run the same tests from <a href={`${repo}/blob/main/docs/performance.md`}>docs/performance.md</a>.</p>

        <div class="blocks" aria-label="Functional block diagram">
          <div class="block">
            <span class="t">UI thread</span>
            <ol class="chain">
              <li>Keys</li><li class="to" aria-hidden="true">→</li>
              <li>Keymap</li><li class="to" aria-hidden="true">→</li>
              <li>Editor core</li><li class="to" aria-hidden="true">→</li>
              <li>View</li><li class="to" aria-hidden="true">→</li>
              <li>GPU frame</li>
            </ol>
            <p>Only the visible lines, rows and list items are built. Text changes in the next frame, with nothing easing into place.</p>
          </div>
          <div class="bus" aria-hidden="true"><span>jobs →</span><span>← events</span></div>
          <div class="block">
            <span class="t">Workers</span>
            <ul class="units">
              <li>Files</li><li>Project index</li><li>git</li><li>ripgrep</li><li>File watcher</li><li>LSP</li>
            </ul>
            <p>A key never waits on the disk, a language server or a process.</p>
          </div>
        </div>
      </section>

      <section class="wrap sheet" id="keys" aria-labelledby="keys-h">
        <h2 id="keys-h">Keys</h2>
        <p class="intro">Two keymaps, each complete. Setup asks which one you want, and can read your leader key from <code>~/.config/nvim</code>.</p>
        <div class="table-wrap">
          <table class="data keys">
            <thead>
              <tr><th scope="col">Action</th><th scope="col">Neovim keymap</th><th scope="col">Classic keymap</th></tr>
            </thead>
            <tbody>
              {
                keys.map(([action, vim, classic]) => (
                  <tr>
                    <th scope="row">{action}</th>
                    <td>{(vim as string[]).map((k) => <kbd>{k}</kbd>)}</td>
                    <td>{(classic as string[]).map((k) => <kbd>{k}</kbd>)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class="lists">
          <div>
            <h3>Neovim keymap</h3>
            <p>Counts, operators, text objects, dot repeat, registers, macros, marks, Replace mode, Visual block, <code>:s</code> with confirm and <code>:g</code>. Tree-sitter adds function, class, parameter and comment objects in 13 languages.</p>
          </div>
          <div>
            <h3>Classic keymap</h3>
            <p>No modes: you type at once. <kbd>Ctrl</kbd> or <kbd>⌘</kbd> shortcuts, Shift to select, and multiple cursors with <kbd>Ctrl</kbd> <kbd>D</kbd>, <kbd>Ctrl</kbd> <kbd>⇧</kbd> <kbd>L</kbd> and Alt-click.</p>
          </div>
        </div>
      </section>

      <section class="wrap sheet" id="agents" aria-labelledby="agents-h">
        <h2 id="agents-h">Works with your agent</h2>
        <p class="intro">editor has no AI inside it. Your agent in the terminal sees what you are looking at and drives the editor over a local socket.</p>
        <div class="grid">
          <figure class="fig f-8">
            <div class="shot"><Plate name="proposal" alt="An agent's proposal shown as a diff in the editor: a PROPOSAL banner with +3 -1, added lines in green and a removed line in red." sizes="(max-width: 1100px) 100vw, 64vw" /></div>
            <figcaption><span class="n">Plate 6</span><strong>A proposal from an agent.</strong><span>It opens as a diff. <kbd>y</kbd> accepts it as one undo step, <kbd>n</kbd> rejects it.</span></figcaption>
          </figure>
          <div class="side side-mid">
            <ul class="does">
              <li><strong>Reads</strong> the active file, cursor, selection, unsaved buffers and LSP errors.</li>
              <li><strong>Points</strong> at lines and leaves a note beside them.</li>
              <li><strong>Proposes</strong> changes that you accept or reject.</li>
              <li><strong>Marks</strong> lines changed on disk. <kbd>SPC</kbd> <kbd>a</kbd> <kbd>l</kbd> lists them.</li>
            </ul>
          </div>
        </div>
        <pre class="term" style="margin-top: var(--space-4)"><code><span class="c"># Claude Code: the editor as tools over MCP</span>
<span class="p">$ </span>claude mcp add editor -- editor mcp

<span class="c"># Any agent or script, from the project folder</span>
<span class="p">$ </span>editor ctl state
<span class="p">$ </span>editor ctl reveal src/main.rs:10-14 --note "this is the bug"
<span class="p">$ </span>sed 's/foo/bar/' src/main.rs | editor ctl propose src/main.rs --label "rename foo"</code></pre>
        <p class="note">The socket is readable by your user only. Set <code>ipc.allow_edits = false</code> to keep agents to proposals. Setup for Codex and opencode is in <a href={`${repo}/blob/main/docs/agents.md`}>docs/agents.md</a>.</p>
      </section>

      <section class="wrap sheet" id="themes" aria-labelledby="themes-h">
        <h2 id="themes-h">Themes</h2>
        <p class="intro">{themes.length} built-in themes, {dark} dark and {light} light. On Omarchy, editor follows the desktop theme as it changes.</p>
        <div class="grid" style="margin-bottom: var(--space-4)">
          <figure class="fig f-8">
            <div class="shot"><Plate name="omarchy" alt="editor in the colours of the Omarchy desktop theme retro-82: amber accents on deep blue and a matching status line." sizes="(max-width: 1100px) 100vw, 64vw" /></div>
            <figcaption><span class="n">Plate 7</span><strong>Omarchy.</strong><span>The colours come from the desktop's current theme, here <code>retro-82</code>.</span></figcaption>
          </figure>
          <div class="side side-mid">
            <p>Set <code>theme.mode = "omarchy"</code> and editor reads the desktop theme. When you change the theme on the desktop, the open window changes with it.</p>
            <p class="muted">Other modes: <code>dark</code>, <code>light</code>, or <code>system</code> to follow the OS.</p>
          </div>
        </div>
        <div class="themes-shots">
          {
            shots.map((s, i) => (
              <figure class="fig">
                <div class="shot"><Plate name={`theme-${s.id}`} alt={`editor in the ${s.name} theme.`} sizes="(max-width: 760px) 100vw, 32vw" /></div>
                <figcaption><span class="n">Plate {8 + i}</span><strong>{s.name}</strong></figcaption>
              </figure>
            ))
          }
        </div>
        <div class="table-wrap" style="margin-top: var(--space-4)">
          <table class="data stack themes-table">
            <thead>
              <tr><th scope="col">Theme</th><th scope="col">Kind</th><th scope="col">Background, accent, Insert, Visual, Command</th><th scope="col">Setting</th></tr>
            </thead>
            <tbody>
              {
                themes.map((t) => (
                  <tr>
                    <th scope="row">{t.name}</th>
                    <td class="kind">{t.light ? "Light" : "Dark"}</td>
                    <td>
                      <span class="swatches" role="img" aria-label={`${t.bg}, ${t.accent}, ${t.insert}, ${t.visual}, ${t.command}`}>
                        {[t.bg, t.accent, t.insert, t.visual, t.command].map((c) => <i style={`background:${c}`} />)}
                      </span>
                    </td>
                    <td class="set"><code>{t.light ? "theme.light" : "theme.dark"} = "{t.id}"</code></td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="wrap sheet" id="ordering" aria-labelledby="order-h">
        <h2 id="order-h">Ordering information</h2>
        <p class="intro">Free and open source under the MIT license. Pick the archive for your system.</p>
        <div class="table-wrap">
          <table class="data stack order">
            <thead>
              <tr><th scope="col">System</th><th scope="col">Architecture</th><th scope="col">Archive</th><th scope="col">Checksum</th></tr>
            </thead>
            <tbody>
              {
                targets.map((t) => (
                  <tr>
                    <th scope="row">{t.system}</th>
                    <td>{t.arch}</td>
                    <td class="arc"><a class="file" href={asset(t.id)}>{archive(t.id)}</a></td>
                    <td class="sum"><a href={`${asset(t.id)}.sha256`}>SHA-256</a></td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class="steps">
          <div>
            <h3>Linux</h3>
            <p>Unpack the archive and put <code>editor</code> on your <code>PATH</code>. The archive also holds a desktop entry and the icon.</p>
            <pre><code>tar -xzf {archive("x86_64-linux")}
install -Dm755 editor-*/editor ~/.local/bin/editor
editor .</code></pre>
          </div>
          <div>
            <h3>macOS</h3>
            <p>The binaries are not signed. Before the first run, remove the quarantine flag.</p>
            <pre><code>tar -xzf {archive("aarch64-macos")}
xattr -d com.apple.quarantine editor-*/editor
./editor-*/editor .</code></pre>
          </div>
          <div>
            <h3>With Cargo</h3>
            <p>Builds from source. Linux needs <code>pkg-config</code> and the Wayland and xkbcommon development packages.</p>
            <pre><code>{install}</code></pre>
          </div>
        </div>
      </section>

      <section class="wrap sheet foot" id="revisions" aria-labelledby="rev-h">
        <h2 id="rev-h">Revision history</h2>
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr><th scope="col">Rev</th><th scope="col">Date</th><th scope="col">Changes</th></tr>
            </thead>
            <tbody>
              {
                revisions
                  .filter((r) => newer(version, r.rev) >= 0)
                  .map((r) => (
                    <tr><th scope="row" class="mono">{r.rev}</th><td class="mono">{r.date}</td><td set:html={r.changes} /></tr>
                  ))
              }
            </tbody>
          </table>
        </div>
        <div class="colophon">
          <span>editor · Rev {version} · MIT license</span>
          <span>Screens rendered by the app itself · <a href={repo}>Source on GitHub</a></span>
        </div>
      </section>
    </main>

    <script define:vars={{ downloads, version }}>
      // Download: name the archive for this visitor's system.
      (function () {
        const ua = navigator.userAgent;
        const plat = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || "";
        const mac = /mac/i.test(plat) || /Macintosh/.test(ua);
        const linux = !mac && (/linux/i.test(plat) || /Linux|X11/.test(ua)) && !/Android/.test(ua);
        const pick = (arm) => (mac ? (arm === false ? "x86_64-macos" : "aarch64-macos") : linux ? (arm ? "aarch64-linux" : "x86_64-linux") : null);
        const show = (id) => {
          const d = id && downloads[id];
          if (!d) return;
          const a = document.getElementById("download");
          a.href = d.href;
          document.getElementById("download-label").textContent = `Download for ${d.system}`;
          document.getElementById("download-file").textContent = `${d.file} · ${d.arch}`;
        };
        show(pick(/aarch64|arm64|armv8/i.test(ua + plat) ? true : mac ? undefined : false));
        if (navigator.userAgentData && navigator.userAgentData.getHighEntropyValues) {
          navigator.userAgentData
            .getHighEntropyValues(["architecture"])
            .then((v) => v.architecture && show(pick(v.architecture === "arm")))
            .catch(() => {});
        }
      })();

      // Plate 1 answers editor's mode keys.
      (function () {
        const plate = document.querySelector(".plate-1");
        const names = { normal: "NORMAL", insert: "INSERT", visual: "VISUAL", command: "COMMAND" };
        const said = document.getElementById("mode-said");
        let mode = "normal";
        const set = (m) => {
          if (m === mode) return;
          mode = m;
          plate.querySelectorAll(".screen > [data-plate]").forEach((p) => (p.hidden = p.dataset.plate !== m));
          plate.querySelectorAll(".modes button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.mode === m)));
          document.getElementById("mode-name").textContent = names[m];
          document.documentElement.style.setProperty("--mode", `var(--${m})`);
          said.textContent = `Plate 1 shows ${names[m].toLowerCase()} mode`;
        };
        plate.querySelectorAll(".modes button").forEach((b) => b.addEventListener("click", () => set(b.dataset.mode)));
        document.addEventListener("keydown", (e) => {
          if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
          if (e.target.closest && e.target.closest("input, textarea, select, [contenteditable]")) return;
          const m = { i: "insert", v: "visual", ":": "command", Escape: "normal" }[e.key];
          if (!m || (m === "normal" && mode === "normal")) return;
          e.preventDefault();
          set(m);
        });
      })();
    </script>
  </body>
</html>
